#!/var/jb/usr/bin/zsh
set -e
PREFIX=/var/jb
LIB=$PREFIX/usr/local/lib/pi-native
BIN=$PREFIX/usr/local/bin

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # runtime/ is fetched and built at install time, so dpkg does not know about
    # it and would leave ~81 MB behind.
    rm -rf "$LIB/runtime" "$LIB/runtime.old"
    # (N) is zsh's null-glob qualifier. Without it an unmatched pattern is an
    # error, and under set -e that makes the ordinary case -- no interrupted
    # install to clean up -- fail the removal.
    rm -rf "$LIB"/.build.*(N)
    # Hand `pi` back to whatever owned it before us.
    if [ -L "$BIN/pi" ]; then
        rm -f "$BIN/pi"
        [ -e "$BIN/pi-legacy" ] && mv "$BIN/pi-legacy" "$BIN/pi" || true
    fi
fi

if [ "$1" = "purge" ]; then
    # Purge means purge: the credential's keychain master does not live under
    # $LIB, so dpkg cannot remove it. `remove` keeps it -- an upgrade or a
    # reinstall must stay signed in, for every provider at once. A
    # PI_PLAINTEXT=1 auth.json is Pi's own file in the user's home; dpkg never
    # owned it and this does not touch it.
    "$LIB/pi-keychain" del >/dev/null 2>&1 || true
fi
exit 0
