<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.private.cs.debugger</key>
    <true/>
    <!-- The JIT set. iOS has no MAP_JIT and will not execute a page that is
         currently writable, so the shim flips the JIT pool with mprotect and
         needs the process to be allowed dynamic code signing at all. See
         README; BUN_JSC_useJIT=0 is a working fallback, but a slow one. -->
    <key>dynamic-codesigning</key>
    <true/>
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <!-- Deliberately NOT com.apple.developer.cs.allow-jit: it is Apple's real
         provisioning-tied JIT entitlement, and on at least one AMFI patch level
         (measured on a research-kernel device) claiming it on an ad-hoc signed
         binary gets the process killed outright, silently, on the very first
         exec -- before any output. It is also unnecessary: the shim never uses
         iOS's real MAP_JIT/pthread_jit_write_protect_np path, only mprotect, so
         this entitlement was never doing anything functional in the first
         place. com.apple.security.cs.allow-jit (the macOS hardened-runtime key,
         meaningless on iOS) is harmless and stays. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Credential storage. Pi keeps every provider credential in
         ~/.pi/agent/auth.json, a plain file it writes itself. On a rootless
         jailbreak $HOME sits on the preboot volume, so the pi-keychain helper
         keeps the master copy in the keychain instead and the wrapper only
         materialises the file while Pi runs. On iOS SecItem access is
         authorized by the signature: without a keychain-access-groups entry
         matching the caller, SecItemAdd returns -34018
         (errSecMissingEntitlement) -- measured on device, an ad-hoc binary
         gets exactly that. The group is named after this package, so it is
         scoped to it and shared with nothing else. -->
    <key>application-identifier</key>
    <string>com.andi.pi-coding-agent</string>
    <key>keychain-access-groups</key>
    <array>
        <string>com.andi.pi-coding-agent</string>
    </array>
</dict>
</plist>
