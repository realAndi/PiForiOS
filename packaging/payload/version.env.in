# Written by tools/build-deb.sh; read by the postinst.
#
# PI_TARBALL_SHA256 is the checksum published in the release's own SHA256SUMS
# asset, confirmed at build time against the tarball actually downloaded.
# PI_BINARY_SHA256 is of the executable inside it, which build-deb.sh computes
# and piios_patch.py --check has already accepted. The postinst re-checks both
# on the device, so a tarball that is not the one this package was built against
# is never patched.
PI_VERSION=@PI_VERSION@
PI_TARBALL_SHA256=@PI_TARBALL_SHA256@
PI_BINARY_SHA256=@PI_BINARY_SHA256@
PI_URL_TARBALL=https://github.com/earendil-works/pi/releases/download/v@PI_VERSION@/pi-darwin-arm64.tar.gz
